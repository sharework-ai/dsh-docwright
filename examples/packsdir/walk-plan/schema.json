{
  "type": "object",
  "required": ["course", "chapters"],
  "properties": {
    "course": {
      "type": "object",
      "required": ["name", "title"],
      "properties": { "name": { "type": "string" }, "title": { "type": "string" } }
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "title", "processes"],
        "properties": {
          "name": { "type": "string" },
          "title": { "type": "string" },
          "processes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "title"],
              "properties": { "name": { "type": "string" }, "title": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
